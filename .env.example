# Supabase (obtené estos valores en https://app.supabase.com → Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# OpenRouter (https://openrouter.ai/keys)
OPENROUTER_API_KEY=sk-or-v1-...

# Admin
ADMIN_EMAIL=tu@email.com

# Vercel Cron protection (generá un string aleatorio seguro)
CRON_SECRET=cambia-esto-por-un-secreto-largo

# App URL (en Vercel se setea automáticamente como VERCEL_URL, pero esta es la URL pública)
NEXT_PUBLIC_APP_URL=https://tu-dominio.vercel.app

# Opcional: HighLevel CRM
# HIGHLEVEL_API_KEY=...
# HIGHLEVEL_LOCATION_ID=...

# NO incluir — se guardan en workspaces.settings via panel /settings/channels:
# YCLOUD_API_KEY → guardado encriptado en DB por workspace
